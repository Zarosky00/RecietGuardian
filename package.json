{
  "name": "receipt-guardian",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx cross-env EXPO_PUBLIC_APP_MODE=production expo start",
    "android": "npx cross-env EXPO_PUBLIC_APP_MODE=production expo start --android",
    "ios": "npx cross-env EXPO_PUBLIC_APP_MODE=production expo start --ios",
    "web": "npx cross-env EXPO_PUBLIC_APP_MODE=production expo start --web --port 8081",
    "web:sandbox": "npx cross-env EXPO_PUBLIC_APP_MODE=sandbox expo start --web --port 8082",
    "ts:check": "tsc"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-image": "~1.12.12",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "tailwindcss": "3.3.2",
    "typescript": "~5.3.3"
  },
  "private": true
}
